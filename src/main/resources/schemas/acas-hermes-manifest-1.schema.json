{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acas.local/schemas/acas-hermes-manifest-1.schema.json",
  "title": "ACAS Hermes archive manifest",
  "type": "object",
  "required": ["format", "batchId", "sha256", "parts", "partCount"],
  "properties": {
    "format": {"enum": ["acas-hermes-archive-1", "acas-hermes-json-parts-1"]},
    "batchId": {"type": "string", "minLength": 1},
    "cipher": {"const": "AES-256-GCM"},
    "kdf": {"const": "PBKDF2-HMAC-SHA256"},
    "iterations": {"const": 210000},
    "compression": {"const": "gzip"},
    "salt": {"type": "string"},
    "nonce": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "activeTestingAllowed": {"type": "boolean"},
    "captureCount": {"type": "integer", "minimum": 0},
    "probeCount": {"type": "integer", "minimum": 0},
    "exactOrigins": {"type": "array", "items": {"type": "string"}},
    "operationSafety": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "partCount": {"type": "integer", "minimum": 1, "maximum": 128},
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["name", "bytes", "sha256"],
        "properties": {
          "name": {"type": "string", "pattern": "^acas-[a-zA-Z0-9-]+\\.part[0-9]{4}$"},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
