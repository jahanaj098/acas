{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(mvn compile)",
      "Bash(mvn test:*)",
      "Bash(mvn package:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Read(./hardening/m2/**)",
      "Read(./target/**)"
    ]
  }
}
